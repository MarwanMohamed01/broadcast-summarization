---
import BaseLayout from "../layouts/BaseLayout.astro";
import Explorer from "../../../design-system/components/shared/Explorer.jsx";
---

<BaseLayout
  title="Explore · TV news multimodal extraction"
  description="Inspect every artifact the pipelines produced — headlines, transcript, summaries, raw OCR."
>
  <section class="border-b border-border">
    <div class="max-w-content mx-auto px-6 pt-20 pb-12">
      <h1 class="text-4xl lg:text-5xl font-semibold tracking-tight">
        Explore the data
      </h1>
      <p class="prose-thesis mt-4 max-w-2xl">
        Browse every artifact produced by both pipelines.  The headlines and
        transcript here are the same files the visual and audio walkthroughs
        animate.  Use the search box to filter.
      </p>
    </div>
  </section>

  <section>
    <div class="max-w-content mx-auto px-6 py-12">
      <Explorer
        client:load
        urls={{
          headlines:  "/data/headlines/news_items_cleaned.json",
          transcript: "/data/transcript/transcript_slice_A.json",
          summaries:  "/data/summaries/visual_14h_cleaned.json",
          raw:        "/data/transcript/transcript_slice_A.txt",
        }}
      />
    </div>
  </section>
</BaseLayout>
