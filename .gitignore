# ── Large media / data (too big for git) ─────────────
videos/*
!videos/extract_demo_clip.py
*.mp4
*.wav
*.mp3
*.avi
*.mov
*.mkv

# ── OCR intermediate outputs (multi-GB) ──────────────
ticker_extraction_v6/output/ticker_frames/
ticker_extraction_v6/output/panorama/
ticker_extraction_v6/output/chunks/*/ticker_frames/
ticker_extraction_v6/output/chunks/*/panorama/

# ── ASR intermediate outputs (multi-GB) ──────────────
asr/output/audio_full.wav
asr/output/audio_slice_*.wav
asr/output/_chunks_transcript_full/

# ── Validation panorama PNGs (15 MB each) ────────────
validation/ground_truth/*.png

# ── Python ────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/

# ── Virtual environments ─────────────────────────────
venv/
.venv/
env/
news_summarization/

# ── Environment variables / secrets ──────────────────
.env
*.env
!.env.example

# ── OS / editor ──────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# ── Web app runtime data ─────────────────────────────
webapp/uploads/*
!webapp/uploads/.gitkeep
webapp/jobs/*
!webapp/jobs/.gitkeep
webapp/frontend/node_modules/
webapp/frontend/dist/

# ── Defense site (site/) ─────────────────────────────
site/node_modules/
site/dist/
site/.astro/
site/public/data/
site/public/video/

# ── Demo clip extracted by videos/extract_demo_clip.py
videos/demo_clip_30s.mp4
videos/demo_clip_30s.wav

# ── Thesis poster assets (kept locally only)
poster/

# ── Logs ─────────────────────────────────────────────
logs/
*.log
